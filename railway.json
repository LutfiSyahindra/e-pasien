{
    "$schema": "https://railway.com/railway.schema.json",
    "deploy": {
        "preDeployCommand": [
            "php artisan migrate --force && php artisan optimize"
        ],
        "healthcheckPath": "/up",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
}
